# Entwicklungs-DB auf dem eigenen Server, per Tunnel: `npm run db:tunnel` offen lassen.
# Laufzeit und drizzle-kit (generate/migrate/push/studio) nutzen dieselbe Verbindung.
DATABASE_URL="postgres://mz_zugang_dev:PASSWORD@127.0.0.1:5433/mz_zugang_dev"
DATABASE_URL_DIRECT="postgres://mz_zugang_dev:PASSWORD@127.0.0.1:5433/mz_zugang_dev"

# Gemeinsames Portal-Passwort als Hash (Format "salt:hash").
# Erzeugen mit: npm run hash-password -- "DasPasswort"
PORTAL_PASSWORD_HASH=""

# Zufälliger String zum Signieren des Session-Cookies, z.B. `openssl rand -hex 32`
SESSION_SECRET=""
