# Supabase-Dashboard → Button "Connect" (oben im Projekt, nicht unter Settings)
# Laufzeit (Vercel Functions): Reiter "Transaction pooler", Port 6543
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Für drizzle-kit (generate/migrate/push/studio): Reiter "Direct connection", Port 5432
DATABASE_URL_DIRECT="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# Gemeinsames Portal-Passwort als Hash (Format "salt:hash").
# Erzeugen mit: npm run hash-password -- "DasPasswort"
PORTAL_PASSWORD_HASH=""

# Zufälliger String zum Signieren des Session-Cookies, z.B. `openssl rand -hex 32`
SESSION_SECRET=""
